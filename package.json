{
  "name": "todo-web-app",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "A React todo web app with priorities, filters, search, sorting, undo and localStorage persistence.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
